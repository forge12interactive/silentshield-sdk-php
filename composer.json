{
    "name": "forge12interactive/silentshield-sdk",
    "description": "SilentShield PHP SDK — human/form verification, AI-agent observation, and policy enforcement (block AI bots) in one dependency-free package.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "silentshield",
        "bot",
        "verification",
        "ai-agent",
        "telemetry",
        "captcha",
        "geo",
        "enforce"
    ],
    "homepage": "https://silentshield.io",
    "authors": [
        {
            "name": "Forge12 Interactive",
            "email": "info@forge12.com",
            "homepage": "https://silentshield.io"
        }
    ],
    "support": {
        "email": "info@forge12.com",
        "docs": "https://silentshield.io/docs/integration/agent-enforce"
    },
    "require": {
        "php": ">=8.1",
        "ext-sodium": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "SilentShield\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
